# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# Required: your Anthropic API key (console.anthropic.com → API Keys). Starts with sk-ant-
# Also set a monthly spend limit in the Console (Settings → Limits).
ANTHROPIC_API_KEY=

# Optional: which Claude model to use. Haiku 5.5 is the cheapest (~$0.0004-0.001 per run).
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: the app refuses new AI calls once this much (USD) is spent today. Tracked in .spend.json.
DAILY_BUDGET_USD=1.00

# Optional: local port (http://127.0.0.1:3000).
PORT=3000

# Optional: PostHog analytics for the local app (project token + host from PostHog → Settings → Project).
# The phc_ token is a public browser key, not a secret, but keep it here rather than in code.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
