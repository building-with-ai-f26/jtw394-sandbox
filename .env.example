# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# Required: your OpenRouter key (https://openrouter.ai/keys). Set a spending limit on the key there too.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional: which OpenRouter model to use (default below is cheap: ~$0.0003 per run).
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Optional: the app refuses new AI calls once this much (USD) is spent today. Tracked in .spend.json.
DAILY_BUDGET_USD=1.00

# Optional: local port (http://127.0.0.1:3000).
PORT=3000
